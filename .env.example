# Proveedor por defecto: "openai" o "anthropic"
LLM_PROVIDER=openai

# API keys (dejar vacia la del proveedor que no se use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos a utilizar, verificar antes en la documentación de cada proveedor
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# Parámetros de generación (opcionales, comunes a todos los proveedores)
# LLM_TEMPERATURE: 0 a 2. Solo la usa OpenAI; Anthropic la ignora.
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS: 1 a 4096.
LLM_MAX_TOKENS=512
